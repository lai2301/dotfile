[{ 
  "name": "rightbar",
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
  "modules-center": ["custom/notification","clock", "custom/tasks", "custom/update", "custom/screenrecording-indicator", "custom/teams-screen-sharing-indication"],
  "modules-right": [
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/gpu",
    "temperature"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "L1",
      "2": "L2",
      "3": "L3",
      "4": "R1",
      "5": "R2",
      "6": "R3",
      "7": "7",
      "8": "8",
      "9": "9",
      "10": "0",
      "active": "󱓻"
    },
    "persistent-workspaces": {
      "HDMI-A-1": [1,2,3],
      "DP-3": [4,5,6]
    }
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": false,
    "active-first": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/omarchy": {
    "format": "<span font='omarchy'>\ue900</span>",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 3600
  },
  "memory": {
    "interval": 5,
    "format": "MEM:{}%",
    "tooltip": true,
    "tooltip-format": "Memory Usage:{used} / {total} ({percentage}%)",
    "max-length": 10
  },
  "cpu": {
    "interval": 5,
    "format": "CPU:{usage}%",
    "on-click": "omarchy-launch-or-focus-tui btop"
  },
  "temperature": {
    "format": " {temperatureC}°C {icon}",
    "tooltip": true,
    "tooltip-format": "Temperatura: {temperatureC}°C\nCritcal > 80°C",
    "format-icons": [
      ""
    ]
  },
  "clock": {
    "format": "{:L%d %B W%V %Y %A %H:%M}",
    "tooltip": true,
    "on-click": "omarchy-launch-floating-terminal-with-presentation $HOME/.config/waybar/script/show-tasks.sh",
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select",
    "tooltip-format": "<span size='15pt'>{calendar}</span>",
    "calendar": {
    "mode": "month",
    "weeks-pos": "right",
    "format": {
      "months":   "<span color='#ff6699'><b>{}</b></span>",
      "days":     "<span color='#cdd6f4'><b>{}</b></span>",
      "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
      "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },
  "custom/tasks": {
    "format": "{}",
    "return-type": "json",
    "exec": "WaybarObsidainTask -sort=lastmod -config=$HOME/.config/waybar/custom-task-config.json",
    "on-click": "omarchy-launch-floating-terminal-with-presentation WaybarObsidainTask -display -config=$HOME/.config/waybar/custom-task-config.json",
    "interval": 300,
    "tooltip": true
    // Sort options: lastmod, date, ticket, name, progress
    // Config: ~/.config/waybar/custom-task-config.json
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "omarchy-launch-wifi"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "omarchy-launch-bluetooth"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "omarchy-launch-or-focus-tui wiremix",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  },
  "custom/gpu": {
    "exec": "$HOME/.config/waybar/script/gpu-amdgpu_top.sh",
    "format": " {}",
    "interval": 10,                    // update every 2 seconds (adjust as you like)
    "tooltip": true
  },
  "output": "DP-3"
},


// Left Bar
{ 
  "name": "leftbar",
